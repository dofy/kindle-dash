# Kindle 看板配置。改完点 LuCI 上的「保存并重建」，设备下次唤醒即生效。
# 不需要插 USB。

# 页面序列。设备按这个顺序轮播，重复某一页就等于加权。
# 例：1 2 1 3  →  天气、状态、天气、备忘，天气出现的频率是其他页的两倍。
SEQ=1 2 1 3

# 唤醒时刻，写每小时的第几分钟，空格分隔。
# 服务端在 :07 :22 :37 :52 构建，所以默认比它晚两分钟。
# 条目越多刷新越频繁，也越耗电：4 条 = 每小时 4 次，12 条 = 每小时 12 次。
WAKE_MINUTES=9 24 39 54

# 1 = 按上面的时刻唤醒（推荐，图总是新的）
# 0 = 按固定间隔 INTERVAL 唤醒，相位会和服务端构建错开
ALIGN=1
INTERVAL=900

# 每页用哪个生成器。加一页就加一项，页号必须连续从 1 开始。
PAGE_SPECS=1:fetch.py 2:status.py 3:notes.py
